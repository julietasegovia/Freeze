[sub_resource type="Shader" id="Shader_crt"]
code = "shader_type canvas_item;

uniform float static_intensity : hint_range(0.0, 1.0) = 0.14;

float rand(vec2 co) {
	return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	float noise = rand(UV * vec2(800.0, 600.0) + TIME * 60.0);
	float scanline = sin(UV.y * 600.0) * 0.06;
	float line_bar = smoothstep(0.98, 1.0, sin(UV.y * 8.0 - TIME * 2.5)) * 0.12;
	float alpha = clamp(noise * static_intensity + scanline + line_bar, 0.0, 0.45);
	COLOR = vec4(0.75, 0.88, 0.98, alpha);
}
"

