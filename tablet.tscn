[sub_resource type="GDScript" id="GDScript_2015u"]
script/source = "extends Node2D

@onready var equation_label: Label = $Equation
@onready var buttons: Array[Button] = [
	$\"Equation/Answer1\",
	$\"Equation/Answer2\",
	$\"Equation/Answer3\",
]
@onready var fireplace = $Fireplace
@onready var wordsearch = $WordsearchMinigame

var correct_answer: int
var finished := false

func _ready() -> void:
	fireplace.hide()
	wordsearch.hide()
	equation_label.show()
	fireplace.connect(\"solved\", _on_fireplace_solved)
	wordsearch.connect(\"word_found\", _on_wordsearch_solved)
	for button in buttons:
		button.pressed.connect(_on_answer_pressed.bind(button))
	new_equation()

func new_equation() -> void:
	var a := randi_range(1, 20)
	var b := randi_range(1, 20)
	var c := randi_range(1, 20)
	correct_answer = a + b - c
	equation_label.text = \"%d + %d - %d =\" % [a, b, c]

	var choices: Array[int] = [correct_answer]
	while choices.size() < 3:
		var decoy := randi_range(2, 18)
		if decoy != correct_answer and decoy not in choices:
			choices.append(decoy)
	choices.shuffle()

	for i in buttons.size():
		buttons[i].text = str(choices[i])
		buttons[i].disabled = false

func _on_answer_pressed(button: Button) -> void:
	if finished:
		return
	if int(button.text) == correct_answer:
		_show_fireplace()
	else:
		new_equation()

func _on_fireplace_solved() -> void:
	_show_wordsearch()

func _on_wordsearch_solved(_word: String) -> void:
	await get_tree().create_timer(0.8).timeout
	_show_math()

func _show_fireplace() -> void:
	finished = true
	equation_label.hide()
	wordsearch.hide()
	fireplace.reset_puzzle()
	fireplace.show()

func _show_wordsearch() -> void:
	finished = true
	equation_label.hide()
	fireplace.hide()
	wordsearch.start_new_puzzle()
	wordsearch.show()

func _show_math() -> void:
	fireplace.hide()
	wordsearch.hide()
	equation_label.show()
	finished = false
	new_equation()
"

